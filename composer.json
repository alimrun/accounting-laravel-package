{
    "name": "alimrun/laravel-ledger",
    "description": "Double-entry general ledger for Laravel: balanced, append-only, idempotent journals with party sub-ledgers, period close, reconciliation and financial reports.",
    "keywords": ["laravel", "accounting", "ledger", "double-entry", "general-ledger", "bookkeeping", "journal"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Md Alimrun",
            "email": "md.alimrun@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "brick/math": "^0.12|^0.13|^0.14",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Alimrun\\Ledger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alimrun\\Ledger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alimrun\\Ledger\\LedgerServiceProvider"
            ],
            "aliases": {
                "Ledger": "Alimrun\\Ledger\\Facades\\Ledger"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
